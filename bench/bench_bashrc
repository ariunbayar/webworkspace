# Start-up file for the bash that pty_server.py opens (--rcfile): your own
# ~/.bashrc, then a note of each command as it is run, kept in $BENCH_CMDS
# (the last three) so a terminal lost in a reboot can show what it was doing.
[ -f ~/.bashrc ] && . ~/.bashrc

BENCH_CMDS=${BENCH_CMDS:-${WINLIST_CMDS:-}}   # WINLIST_CMDS: set by a terminal started before the rename
__bench_last=
__bench_cmd() {
  local s=$? n c
  read -r n c <<< "$(HISTTIMEFORMAT= history 1)"
  if [ -n "$BENCH_CMDS" ] && [ "$n" != "$__bench_last" ]; then   # Enter on nothing is no command
    [ -n "$__bench_last" ] && {
      { tail -n 2 "$BENCH_CMDS" 2>/dev/null; printf '%s\n' "${c:0:300}"; } > "$BENCH_CMDS.t" \
        && mv -f "$BENCH_CMDS.t" "$BENCH_CMDS"
    }
    __bench_last=$n
  fi
  return $s
}
# what the history ends on now was typed in an earlier shell
read -r __bench_last _ <<< "$(HISTTIMEFORMAT= history 1)"
: "${__bench_last:=0}"
if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" == "declare -a"* ]]; then
  PROMPT_COMMAND+=(__bench_cmd)
else
  PROMPT_COMMAND="${PROMPT_COMMAND:+$PROMPT_COMMAND;}__bench_cmd"
fi
