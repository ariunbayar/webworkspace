# Copy to .env and tweak as needed:  cp .env.example .env
# Host port to expose the workspace on
PORT=8000
# Directory (inside the container) whose source files are shown as boxes.
# Defaults to the whole project; narrow it e.g. to /app/static/js if preferred.
DEMO_DIR=/app
# Minimap thumbnail font size in px (bigger = larger, more legible previews).
THUMB_FONT_SIZE=7
