# Copy to .env and tweak as needed:  cp .env.example .env
# Host port to expose the workspace on
PORT=8000
# Demo project directory (inside the container) seeded into redis.
# Try /app/demo_code_fold for a different sample set.
DEMO_DIR=/app/static/js
# Minimap thumbnail font size in px (bigger = larger, more legible previews).
THUMB_FONT_SIZE=7
